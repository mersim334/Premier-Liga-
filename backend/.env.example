# Kopiraj ovaj fajl kao backend/.env i popuni vrijednosti.

# PostgreSQL (kad je postavljen, svi GET endpointi čitaju iz baze umjesto mocka)
# DATABASE_URL=postgresql://postgres:tvoja_lozinka@127.0.0.1:5432/bih_premier_liga

# Provjera: GET http://127.0.0.1:8000/db-health — treba status ok i sve tablice true.
#
# Kad su tabele kreirane (PostgreSQL DDL iz Premier Liga/sql/), puni demo:
#   cd backend && python scripts/apply_seed.py
# Koristi Premier Liga/sql/seed_minimal.sql (10 klubova, dvije sezone u mock/seedu,
# mečevi, igrači, sudije gdje je u šemi).
